{
  "version": 3,
  "title": "SOPH.IA",
  "outputters": [
    {
      "name": "react",
      "config": {}
    }
  ],
  "parser": "react",
  "codeConnect": {
    "parserVersion": "2"
  },
  "include": "src/figma/**/*.figma.ts",
